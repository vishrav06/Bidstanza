# Bidstanza environment configuration template.
# Copy to `.env` and fill in values; app/core/config.py loads it via pydantic-settings.
# URLs must use the asyncpg driver prefix (postgresql+asyncpg://).

# --- database ---
DATABASE_URL=postgresql+asyncpg://bidstanza:bidstanza@localhost:5432/bidstanza
TEST_DATABASE_URL=postgresql+asyncpg://bidstanza:bidstanza@localhost:5432/bidstanza_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- auction engine ---
SOFT_CLOSE_WINDOW_S=60
SOFT_CLOSE_EXTENSION_S=60
SETTLE_INTERVAL_S=1.0
WS_SEND_TIMEOUT_S=2.0
